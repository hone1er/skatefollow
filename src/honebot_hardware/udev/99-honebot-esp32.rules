# honebot ESP32 (Silicon Labs CP2102, 10c4:ea60)
#
# 1. Stable device name /dev/esp32 regardless of ttyUSB numbering.
# 2. closing_wait=none: this CP2102 does not answer the driver's "transmit
#    buffer empty?" request, so every close() of the port blocks ~5 s waiting
#    for the USB control timeout. Skipping the wait makes the bridge exit
#    instantly. Needs the 'setserial' package.
#
# Install (on the Pi):
#   sudo apt install setserial
#   sudo cp ~/honebot_ws/src/honebot_hardware/udev/99-honebot-esp32.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   ls -l /dev/esp32          # should point at ttyUSB0
# Then launch with port:=/dev/esp32 (or make it the default in esp32.launch.py).
#
# One-off test without installing anything permanent:
#   sudo setserial /dev/ttyUSB0 closing_wait none

# IMPORTANT — multiple CP2102 boards (robot ESP32 + UWB board or handheld remote):
# The single-board rule below matches EVERY CP2102 (10c4:ea60). As soon as a second CP2102
# board is plugged into the Pi, whichever enumerates last will overwrite /dev/esp32!
# Pin each board by its USB serial number (or physical USB port KERNELS=="1-1.X"):
#   udevadm info -a -n /dev/ttyUSB0 | grep -m1 '{serial}'
# Then comment out the generic SYMLINK rule below and uncomment/fill in the pinned rules:
#
# ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="ROBOT_SERIAL", SYMLINK+="esp32"
# ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="UWB_SERIAL", SYMLINK+="uwb"

# Apply closing_wait=none to every CP2102 board so closing any port never blocks 5 s.
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", RUN+="/usr/bin/setserial /dev/%k closing_wait none"
# Single-board default symlink (replace with the ATTRS{serial}-pinned rules above once UWB/second ESP32 is attached):
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="esp32"
