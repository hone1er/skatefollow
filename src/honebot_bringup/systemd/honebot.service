# honebot bringup at boot.
#
# Install (on the Pi, needs sudo):
#   sudo cp ~/honebot_ws/src/honebot_bringup/systemd/honebot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now honebot.service
# Watch:   journalctl -u honebot -f
# Stop:    sudo systemctl stop honebot      (sends SIGINT; nodes exit cleanly)
# Disable: sudo systemctl disable honebot

[Unit]
Description=honebot ROS 2 bringup (ESP32 bridge, safety gate, Foxglove bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hone1er
WorkingDirectory=/home/hone1er/honebot_ws
Environment=ROS_DOMAIN_ID=0
Environment=RCUTILS_COLORIZED_OUTPUT=0
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/hone1er/honebot_ws/install/setup.bash && exec ros2 launch honebot_bringup bringup.launch.py'
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
